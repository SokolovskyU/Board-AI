{
  "name": "board-ai",
  "displayName": "Board AI",
  "description": "Kanban board, docs and activity panel for managing projects directly inside VS Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:projectControl.open",
    "onCommand:projectControl.ingestPrompt",
    "onCommand:projectControl.syncFromOutbox",
    "onCommand:projectControl.runMultiAgentCycle"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "projectControl.open",
        "title": "Project Control: Open"
      },
      {
        "command": "projectControl.ingestPrompt",
        "title": "Project Control: Ingest Prompt"
      },
      {
        "command": "projectControl.syncFromOutbox",
        "title": "Project Control: Sync From Outbox"
      },
      {
        "command": "projectControl.runMultiAgentCycle",
        "title": "Project Control: Run Multi-Agent Cycle"
      }
    ],
    "configuration": {
      "title": "Project Control",
      "properties": {
        "projectControl.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open Project Control once per VS Code session when a workspace is opened."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit",
    "test:unit": "npm run compile-tests && node ./node_modules/mocha/bin/mocha --ui tdd out/test/projectControl.test.js",
    "test:vscode": "npm run compile-tests && npm run compile && npm run lint && vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "mocha": "^11.7.4"
  }
}
